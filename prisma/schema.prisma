generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  slug         String       @unique
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lectures     Lecture[]
  questions    Question[]
  bibleStudies BibleStudy[]
  articles     Article[]
}

model Question {
  id             Int           @id @default(autoincrement())
  title          String
  slug           String        @unique
  shortAnswer    String
  answer         String
  youtubeUrl     String?
  seoTitle       String?
  seoDescription String?
  featured       Boolean       @default(false)
  status         Status        @default(DRAFT)
  categoryId     Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       Category      @relation(fields: [categoryId], references: [id])
  tags           QuestionTag[]
}

model Lecture {
  id               Int          @id @default(autoincrement())
  title            String
  slug             String       @unique
  shortDescription String?
  content          String?
  youtubeId        String       @unique
  thumbnail        String?
  duration         String?
  speaker          String?
  bibleReference   String?
  seoTitle         String?
  seoDescription   String?
  featured         Boolean      @default(false)
  views            Int          @default(0)
  status           Status       @default(DRAFT)
  categoryId       Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  category         Category     @relation(fields: [categoryId], references: [id])
  tags             LectureTag[]
}

model Tag {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  slug         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lectures     LectureTag[]
  questions    QuestionTag[]
  bibleStudies BibleStudyTag[]
}

model QuestionTag {
  questionId Int
  tagId      Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model LectureTag {
  lectureId Int
  tagId     Int
  lecture   Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([lectureId, tagId])
}

model BibleStudy {
  id               Int            @id @default(autoincrement())
  title            String
  slug             String         @unique
  shortDescription String?
  content          String?
  featuredImage    String?
  bibleReference   String?
  seoTitle         String?
  seoDescription   String?
  featured         Boolean        @default(false)
  status           Status         @default(DRAFT)
  categoryId       Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  category         Category       @relation(fields: [categoryId], references: [id])
  tags             BibleStudyTag[]
}

model BibleStudyTag {
  bibleStudyId Int
  tagId        Int
  bibleStudy   BibleStudy @relation(fields: [bibleStudyId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bibleStudyId, tagId])
}

model Article {
  id               Int          @id @default(autoincrement())
  title            String
  slug             String       @unique
  shortDescription String?
  content          String?
  featuredImage    String?
  bibleReference   String?
  seoTitle         String?
  seoDescription   String?
  featured         Boolean      @default(false)
  views            Int          @default(0)
  status           Status       @default(DRAFT)
  categoryId       Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  category         Category     @relation(fields: [categoryId], references: [id])
}
model PrayerRequest {
  id        Int           @id @default(autoincrement())
  name      String
  email     String?
  request   String
  status    PrayerStatus  @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum PrayerStatus {
  PENDING
  APPROVED
  ANSWERED
  ARCHIVED
}
enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}